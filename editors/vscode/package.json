{
  "name": "m68hc16-asm",
  "displayName": "M68HC16 Assembly",
  "description": "Syntax highlighting, build task problem matcher and DOS code page defaults for Motorola M68HC16 (CPU16) assembly in the MASM dialect.",
  "version": "0.1.0",
  "publisher": "hausrummel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/HausRummel/M68HC16_Assembler",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "68hc16",
    "cpu16",
    "motorola",
    "assembly",
    "masm"
  ],
  "contributes": {
    "languages": [
      {
        "id": "m68hc16",
        "aliases": [
          "M68HC16 Assembly",
          "m68hc16"
        ],
        "extensions": [
          ".asm",
          ".ASM",
          ".inc",
          ".INC"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "m68hc16",
        "scopeName": "source.m68hc16",
        "path": "./syntaxes/m68hc16.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[m68hc16]": {
        "files.encoding": "cp437",
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    },
    "problemMatchers": [
      {
        "name": "m68hc16",
        "label": "M68HC16 assembler",
        "owner": "m68hc16",
        "source": "m68hc16-asm",
        "applyTo": "allDocuments",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|note): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ]
  }
}
