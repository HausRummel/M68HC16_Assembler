{
  "name": "m68hc16-asm",
  "displayName": "M68HC16 Assembly",
  "description": "Syntax highlighting, live errors, go to definition and hover for Motorola M68HC16 (CPU16) assembly in the MASM dialect.",
  "version": "0.2.0",
  "publisher": "hausrummel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/HausRummel/M68HC16_Assembler",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "68hc16",
    "cpu16",
    "motorola",
    "assembly",
    "masm"
  ],
  "activationEvents": [
    "onLanguage:m68hc16"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "m68hc16",
        "aliases": [
          "M68HC16 Assembly",
          "m68hc16"
        ],
        "extensions": [
          ".asm",
          ".ASM",
          ".inc",
          ".INC"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "m68hc16",
        "scopeName": "source.m68hc16",
        "path": "./syntaxes/m68hc16.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[m68hc16]": {
        "files.encoding": "cp437",
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    },
    "problemMatchers": [
      {
        "name": "m68hc16",
        "label": "M68HC16 assembler",
        "owner": "m68hc16",
        "source": "m68hc16-asm",
        "applyTo": "allDocuments",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|note): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "commands": [
      {
        "command": "m68hc16.restartServer",
        "title": "Restart Language Server",
        "category": "M68HC16"
      }
    ],
    "configuration": {
      "title": "M68HC16",
      "properties": {
        "m68hc16.rootFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Top-level files to assemble (the ones that `INCLUDE` the rest), absolute or relative to the first workspace folder. Empty: use every source no other source includes."
        },
        "m68hc16.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `m68hc16-lsp`. Empty: use one shipped with the extension, else find it on `PATH`."
        },
        "m68hc16.server.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run the language server (live errors, go to definition, hover)."
        },
        "m68hc16.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log messages between VS Code and the language server to the Output panel."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.82.0",
    "typescript": "^5.4.0"
  }
}
